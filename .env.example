# Base URL of the Wharf backend API. Leave empty in dev to use the Vite proxy
# (/api -> http://localhost:8080). Set to the API origin in production, e.g.
# VITE_API_URL=https://api.wharf.sh
VITE_API_URL=

# Optional: override the dev proxy target (defaults to http://localhost:8080).
# VITE_DEV_API_TARGET=http://localhost:8080
