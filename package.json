{
  "name": "wharf-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 5173",
    "generate-routes": "tsr generate",
    "gen:api": "orval --config orval.config.ts",
